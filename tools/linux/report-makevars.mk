$(info OPT_VECTOR=$(OPT_VECTOR))
$(info LTO_FLAGS=$(LTO_FLAGS))
$(info LDFLAGS=$(LDFLAGS))
$(info SHLIB_LIBS=$(SHLIB_LIBS))
$(info MAKEFLAGS=$(MAKEFLAGS))
